{
  "name": "lurkd",
  "version": "0.2.1",
  "description": "Let your coding agent read the forums AI search tends to miss, public or behind a login, read-only, into a local archive of threaded Markdown.",
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agents",
    "claude-code",
    "forum",
    "discourse",
    "xenforo",
    "read-only",
    "archive",
    "cli"
  ],
  "homepage": "https://dev-136.gitbook.io/lurkd/",
  "bugs": {
    "url": "https://github.com/rospocroccante/lurkd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rospocroccante/lurkd.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "bin": {
    "lurkd": "dist/bin/lurkd.js"
  },
  "files": [
    "dist",
    "ui",
    "sources",
    "skills",
    ".claude-plugin",
    ".mcp.json",
    ".cursor-plugin",
    "gemini-extension.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration --testTimeout=60000",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.17",
    "linkedom": "0.18.15",
    "playwright": "1.65.0",
    "turndown": "7.2.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/turndown": "5.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
